        ],
        "GCC_WARN_INHIBIT_ALL_WARNINGS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "HEADER_SEARCH_PATHS": "\"$(SRCROOT)/Econo Camera/LAME\"",
        "INFOPLIST_KEY_CFBundleDisplayName": "Econo Camera",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.travel",
        "INFOPLIST_KEY_LSSupportsOpeningDocumentsInPlace": "YES",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Econo Camera uses the camera to take small videos, photos and panoramas.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Econo Camera records sound with your videos.",
        "INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription": "Econo Camera can save a copy of your small videos, photos and cartoons to Photos when you ask it to.",
        "INFOPLIST_KEY_NSSpeechRecognitionUsageDescription": "Econo Camera turns the speech in your videos and audio into text on your device.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UIFileSharingEnabled": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
